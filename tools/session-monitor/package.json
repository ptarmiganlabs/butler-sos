{
    "name": "qseow-session-monitor",
    "version": "0.2.0",
    "description": "A live view of Qlik Sense Enterprise on Windows sessions and the five-session limit",
    "private": true,
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "bin": {
        "qseow-session-monitor": "src/index.js"
    },
    "scripts": {
        "start": "node src/index.js",
        "demo": "node src/index.js --simulate 300",
        "test": "node --test \"test/*.test.mjs\"",
        "build:binary": "node scripts/build-binary.mjs"
    },
    "dependencies": {
        "js-yaml": "5.4.2",
        "mqtt": "5.15.2"
    },
    "devDependencies": {
        "esbuild": "0.28.1",
        "postject": "1.0.0-alpha.6"
    }
}
